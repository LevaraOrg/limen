#!/bin/bash
# limen — ‹limen› Schwelle. Sagt, welche Identität hinter dieser Verzeichnis-
# schwelle gilt, und exportiert sie.
#
#   limen show      lesbare Übersicht
#   limen json      maschinenlesbar
#   limen shell     export-Zeilen für  eval "$(limen shell)"
#   limen prompt    einzeiliges Segment für RPROMPT / Statuszeile
#   limen root      Pfad des Projektwurzelverzeichnisses
#   limen init      .limen.yaml im aktuellen Verzeichnis anlegen
#   limen hook zsh  chpwd-Hook zum Einbinden in .zshrc
#
# Keine Abhängigkeiten außer awk. Der Hook läuft bei jedem cd, deshalb ist
# jeder vermeidbare Subprozess hier entfernt: kein dirname, kein basename,
# kein sed. Ein awk-Aufruf je gelesener Datei, sonst nur Bash-Bordmittel.
# Der Schlüsselbund wird nur angefasst, wenn der Schlüssel wirklich gebraucht
# wird — security(1) kostet allein rund 20 ms.

set -eu

VERSION="0.1.0"

FOUND=0
ROOT=""
FLAVOUR=""
KEY_CHECKED=0
KEY_VALUE=""
KEY_FOUND=1

# ---------------------------------------------------------------- Auffinden

# Sucht aufwärts vom aktuellen Verzeichnis. Ein Aufruf tief im Projektbaum
# liefert damit den Kontext dieses Projekts — genau das ist der Zweck.
find_root() {
    local dir="$PWD"
    while [[ -n "$dir" && "$dir" != "/" ]]; do
        if [[ -f "$dir/.limen.yaml" ]]; then
            ROOT="$dir"; FLAVOUR="limen"; return 0
        fi
        if [[ -f "$dir/.orca/config.yaml" || -f "$dir/.orca/identity.yaml" ]]; then
            ROOT="$dir"; FLAVOUR="orca"; return 0
        fi
        dir="${dir%/*}"
    done
    return 1
}

# ------------------------------------------------------------------ Parsen

# Flaches YAML: key: value, ein Paar je Zeile. Mehr braucht ein Kontext-
# descriptor nicht, und ein Parser für mehr wäre ein Grund, eine Abhängigkeit
# zu ziehen. Gibt shell-quotierte Zuweisungen mit Präfix F_ aus.
parse_flat() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    awk '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        /^---/           { next }
        /^[[:space:]]/   { next }   # verschachtelte Blöcke gehören nicht hierher
        {
            i = index($0, ":")
            if (i == 0) next
            key = substr($0, 1, i - 1)
            val = substr($0, i + 1)

            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)

            # Nachgestellter Kommentar, aber nur außerhalb von Anführungszeichen.
            if (val !~ /^"/ && val !~ /^'"'"'/) {
                h = index(val, "#")
                if (h > 0) {
                    val = substr(val, 1, h - 1)
                    gsub(/[[:space:]]+$/, "", val)
                }
            }
            if (val ~ /^".*"$/)          val = substr(val, 2, length(val) - 2)
            else if (val ~ /^'"'"'.*'"'"'$/) val = substr(val, 2, length(val) - 2)

            if (val == "") next
            if (key !~ /^[A-Za-z_][A-Za-z0-9_-]*$/) next

            gsub(/-/, "_", key)
            gsub(/'"'"'/, "'"'"'\\'"'"''"'"'", val)
            printf "F_%s='"'"'%s'"'"'\n", toupper(key), val
        }
    ' "$file"
}

load_context() {
    find_root || return 0
    FOUND=1

    if [[ "$FLAVOUR" == "limen" ]]; then
        eval "$(parse_flat "$ROOT/.limen.yaml")"
    else
        # Rückwärtskompatibel: ein bestehendes .orca/ lädt unverändert weiter.
        # Schritt 1 der Migration soll nichts kaputt machen.
        eval "$(parse_flat "$ROOT/.orca/identity.yaml")"
        eval "$(parse_flat "$ROOT/.orca/config.yaml")"
    fi

    ACTOR="${F_NAME:-${F_ACTOR:-}}"
    GH_USER="${F_GITHUBUSER:-}"
    CLAUDE_DIR="${F_CLAUDECONFIGDIR:-}"
    GCLOUD_ACCOUNT="${F_GCLOUDACCOUNT:-}"
    GCLOUD_PROJECT="${F_GCLOUDPROJECT:-}"
    PROVIDER="${F_PROVIDER:-}"
    MODEL="${F_MODEL:-}"
    LABEL="${F_LABEL:-${ROOT##*/}}"
    GATEWAY="${F_GATEWAY:-}"
    KEYCHAIN_SERVICE="${F_KEYCHAINSERVICE:-}"
    KEYCHAIN_ACCOUNT="${F_KEYCHAINACCOUNT:-}"

    # Ein Klartextschlüssel in der Datei ist ein Warnzeichen, kein Feature.
    if [[ -n "${F_APIKEY:-}" ]]; then KEY_IN_CONFIG=1; else KEY_IN_CONFIG=0; fi

    # Tilde ohne Subprozess auflösen.
    if [[ "$CLAUDE_DIR" == "~" ]]; then
        CLAUDE_DIR="$HOME"
    elif [[ "$CLAUDE_DIR" == "~/"* ]]; then
        CLAUDE_DIR="$HOME/${CLAUDE_DIR#\~/}"
    fi
}

# ---------------------------------------------------------------- Schlüssel

# Wird nie in show oder json ausgegeben. Nur shell exportiert ihn, weil das
# sein Zweck ist. Auflösung: vorhandene Umgebungsvariable, dann Schlüsselbund.
# Ergebnis wird gecacht, damit derselbe Lauf security(1) nicht zweimal ruft.
resolve_key() {
    if [[ "$KEY_CHECKED" -eq 1 ]]; then
        [[ -n "$KEY_VALUE" ]] && printf '%s' "$KEY_VALUE"
        return "$KEY_FOUND"
    fi
    KEY_CHECKED=1
    KEY_FOUND=1
    KEY_VALUE=""

    [[ "${PROVIDER:-}" == "anthropic" ]] || return 1
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        KEY_VALUE="$ANTHROPIC_API_KEY"; KEY_SOURCE="ANTHROPIC_API_KEY"; KEY_FOUND=0
        printf '%s' "$KEY_VALUE"; return 0
    fi

    local svc="${KEYCHAIN_SERVICE:-limen-$PROVIDER}"
    local acct="${KEYCHAIN_ACCOUNT:-$ACTOR}"
    [[ -n "$acct" ]] || return 1
    command -v security >/dev/null 2>&1 || return 1

    local out
    if out="$(security find-generic-password -s "$svc" -a "$acct" -w 2>/dev/null)"; then
        KEY_VALUE="$out"; KEY_SOURCE="keychain $svc"; KEY_FOUND=0
        printf '%s' "$KEY_VALUE"; return 0
    fi
    return 1
}

key_source() {
    if [[ "${PROVIDER:-}" != "anthropic" ]]; then
        printf 'n/a (provider=%s)' "${PROVIDER:-unset}"; return 0
    fi
    if resolve_key >/dev/null 2>&1; then
        printf '%s' "${KEY_SOURCE:-resolved}"
    else
        printf 'not resolvable'
    fi
}

# ----------------------------------------------------------------- Ausgaben

# Escaping in Bash statt per sed-Fork: bei zehn Feldern sind das zehn
# Subprozesse weniger, und genau die machten json vorher dreimal so langsam
# wie die übrigen Unterbefehle.
je() {
    local v="${1//\\/\\\\}"
    v="${v//\"/\\\"}"
    printf '%s' "$v"
}

emit_json() {
    if [[ "$FOUND" -eq 0 ]]; then printf '{}\n'; return 0; fi
    local key_present=false key_in_cfg=false
    resolve_key >/dev/null 2>&1 && key_present=true
    [[ "$KEY_IN_CONFIG" -eq 1 ]] && key_in_cfg=true
    printf '{"root":"%s","label":"%s","actor":"%s","github_user":"%s",' \
        "$(je "$ROOT")" "$(je "$LABEL")" "$(je "$ACTOR")" "$(je "$GH_USER")"
    printf '"claude_config_dir":"%s","gcloud_account":"%s","gcloud_project":"%s",' \
        "$(je "$CLAUDE_DIR")" "$(je "$GCLOUD_ACCOUNT")" "$(je "$GCLOUD_PROJECT")"
    printf '"provider":"%s","model":"%s","gateway":"%s","source":"%s",' \
        "$(je "$PROVIDER")" "$(je "$MODEL")" "$(je "$GATEWAY")" "$FLAVOUR"
    printf '"api_key_present":%s,"api_key_in_config":%s}\n' "$key_present" "$key_in_cfg"
}

emit_show() {
    if [[ "$FOUND" -eq 0 ]]; then
        echo "limen: kein .limen.yaml und kein .orca/ oberhalb von $PWD" >&2
        return 1
    fi
    printf 'root:         %s\n' "$ROOT"
    printf 'label:        %s\n' "$LABEL"
    [[ -n "$ACTOR" ]]          && printf 'actor:        %s\n' "$ACTOR"
    [[ -n "$GH_USER" ]]        && printf 'github user:  %s\n' "$GH_USER"
    [[ -n "$CLAUDE_DIR" ]]     && printf 'claude dir:   %s\n' "$CLAUDE_DIR"
    [[ -n "$GCLOUD_ACCOUNT" ]] && printf 'gcloud acct:  %s\n' "$GCLOUD_ACCOUNT"
    [[ -n "$GCLOUD_PROJECT" ]] && printf 'gcloud proj:  %s\n' "$GCLOUD_PROJECT"
    [[ -n "$PROVIDER" ]]       && printf 'provider:     %s\n' "$PROVIDER"
    [[ -n "$MODEL" ]]          && printf 'model:        %s\n' "$MODEL"
    [[ -n "$GATEWAY" ]]        && printf 'gateway:      %s\n' "$GATEWAY"
    printf 'api key:      %s\n' "$(key_source)"
    if [[ "$FLAVOUR" == "orca" ]]; then
        printf 'source:       .orca/ (legacy)\n'
    else
        printf 'source:       .limen.yaml\n'
    fi
    if [[ "$KEY_IN_CONFIG" -eq 1 ]]; then
        printf '\nWarnung: ein Klartextschlüssel steht noch in der Konfiguration.\n'
        printf 'Verschieben:  limen keychain-import\n'
    fi
    return 0
}

# Leere Werte werden ausgelassen, damit ein Wechsel in ein Projekt ohne das
# jeweilige Feld nicht eine leere Variable exportiert und Werkzeuge verwirrt.
emit_shell() {
    [[ "$FOUND" -eq 1 ]] || return 0
    printf "export LIMEN_ROOT='%s'\n" "$ROOT"
    printf "export LIMEN_LABEL='%s'\n" "$LABEL"
    [[ -n "$ACTOR" ]]          && printf "export LIMEN_ACTOR='%s'\n" "$ACTOR"
    [[ -n "$GH_USER" ]]        && printf "export LIMEN_GH_USER='%s'\n" "$GH_USER"
    [[ -n "$PROVIDER" ]]       && printf "export LIMEN_PROVIDER='%s'\n" "$PROVIDER"
    [[ -n "$MODEL" ]]          && printf "export LIMEN_MODEL='%s'\n" "$MODEL"
    [[ -n "$CLAUDE_DIR" ]]     && printf "export CLAUDE_CONFIG_DIR='%s'\n" "$CLAUDE_DIR"
    [[ -n "$GCLOUD_ACCOUNT" ]] && printf "export CLOUDSDK_CORE_ACCOUNT='%s'\n" "$GCLOUD_ACCOUNT"
    [[ -n "$GCLOUD_PROJECT" ]] && printf "export CLOUDSDK_CORE_PROJECT='%s'\n" "$GCLOUD_PROJECT"
    # Zeigt auf ein lokales Nuncio: damit ist die Modellroute eine Eigenschaft
    # des Projekts und nicht der Shell, aus der man es gestartet hat.
    [[ -n "$GATEWAY" ]]        && printf "export ANTHROPIC_BASE_URL='%s'\n" "$GATEWAY"
    # Das Prompt-Segment kommt mit, damit der chpwd-Hook mit einem einzigen
    # Aufruf auskommt. Zwei Aufrufe hießen zwei Prozessstarts und zwei
    # Schlüsselbund-Zugriffe pro cd.
    printf "export LIMEN_SEGMENT='%s'\n" "$(emit_prompt)"
    local k
    if k="$(resolve_key 2>/dev/null)"; then
        printf "export ANTHROPIC_API_KEY='%s'\n" "$k"
    fi
    return 0
}

# Berührt den Schlüsselbund absichtlich nicht: das Segment wird bei jedem
# Prompt neu gezeichnet, 20 ms security(1) wären dort sofort spürbar.
emit_prompt() {
    [[ "$FOUND" -eq 1 ]] || return 0
    local out="$LABEL"
    [[ -n "$GH_USER" ]] && out="$out · $GH_USER"
    [[ -n "$MODEL" ]]   && out="$out · $MODEL"
    [[ "$KEY_IN_CONFIG" -eq 1 ]] && out="$out · !key-in-config"
    printf '%s\n' "$out"
    return 0
}

# --------------------------------------------------------------- Unterbefehle

cmd_init() {
    local target="$PWD/.limen.yaml"
    if [[ -e "$target" ]]; then
        echo "limen: $target existiert bereits" >&2
        return 1
    fi
    cat > "$target" <<EOF
# limen — Kontext dieses Verzeichnisbaums.
# Flaches YAML: ein key: value je Zeile. Alle Felder sind optional.
label: ${PWD##*/}
actor:
githubUser:
claudeConfigDir:
gcloudAccount:
gcloudProject:
provider: anthropic
model: claude-opus-5

# Zeigt ANTHROPIC_BASE_URL auf ein lokales Nuncio, damit die Modellroute zum
# Projekt gehört und nicht zur Shell. Leer lassen für die echte API.
gateway:

# Schlüsselbund statt Klartext. keychainAccount fällt auf actor zurück.
keychainService: limen-anthropic
keychainAccount:
EOF
    printf 'angelegt: %s\n' "$target"
}

cmd_keychain_import() {
    [[ "$FOUND" -eq 1 ]] || { echo "limen: kein Kontext gefunden" >&2; return 1; }
    [[ "$KEY_IN_CONFIG" -eq 1 ]] || { echo "limen: kein Klartextschlüssel in der Konfiguration" >&2; return 1; }
    command -v security >/dev/null 2>&1 || { echo "limen: security(1) nur auf macOS" >&2; return 1; }
    local svc="${KEYCHAIN_SERVICE:-limen-${PROVIDER:-anthropic}}"
    local acct="${KEYCHAIN_ACCOUNT:-$ACTOR}"
    [[ -n "$acct" ]] || { echo "limen: actor oder keychainAccount muss gesetzt sein" >&2; return 1; }
    security add-generic-password -U -s "$svc" -a "$acct" -w "$F_APIKEY"
    printf 'im Schlüsselbund abgelegt: service=%s account=%s\n' "$svc" "$acct"
    printf 'Jetzt die Zeile apiKey: aus der Konfiguration entfernen.\n'
}

cmd_hook() {
    case "${1:-zsh}" in
        zsh)
            cat <<'EOF'
# limen — in .zshrc einbinden:  eval "$(limen hook zsh)"
# Ein Aufruf je Verzeichniswechsel; LIMEN_SEGMENT kommt aus derselben Ausgabe.
_limen_apply() {
  local out
  out="$(limen shell 2>/dev/null)" || return 0
  if [[ -n "$out" ]]; then
    eval "$out"
  else
    unset LIMEN_ROOT LIMEN_LABEL LIMEN_ACTOR LIMEN_GH_USER LIMEN_SEGMENT
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _limen_apply
_limen_apply
# Optional in der Statuszeile:
#   RPROMPT='%F{244}${LIMEN_SEGMENT}%f'
EOF
            ;;
        bash)
            cat <<'EOF'
# limen — in .bashrc einbinden:  eval "$(limen hook bash)"
_limen_apply() {
  local out
  out="$(limen shell 2>/dev/null)" || return 0
  if [[ -n "$out" ]]; then
    eval "$out"
  else
    unset LIMEN_ROOT LIMEN_LABEL LIMEN_ACTOR LIMEN_GH_USER LIMEN_SEGMENT
  fi
}
PROMPT_COMMAND="_limen_apply${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
_limen_apply
EOF
            ;;
        *)
            echo "limen: unbekannte Shell '$1' (zsh, bash)" >&2
            return 1
            ;;
    esac
}

usage() {
    while IFS= read -r line; do
        [[ "$line" == "#"* ]] || break
        printf '%s\n' "${line###}"
    done < <(tail -n +2 "$0")
}

# ------------------------------------------------------------------- Einstieg

cmd="${1:-show}"
case "$cmd" in
    -h|--help|help) usage; exit 0 ;;
    -V|--version)   printf 'limen %s\n' "$VERSION"; exit 0 ;;
esac

load_context

case "$cmd" in
    show)            emit_show ;;
    json)            emit_json ;;
    shell)           emit_shell ;;
    prompt)          emit_prompt ;;
    root)            [[ "$FOUND" -eq 1 ]] && printf '%s\n' "$ROOT" ;;
    init)            cmd_init ;;
    keychain-import) cmd_keychain_import ;;
    hook)            cmd_hook "${2:-zsh}" ;;
    *)               echo "limen: unbekannter Befehl '$cmd'" >&2; usage >&2; exit 2 ;;
esac
